<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/mainview"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:background="@color/white">

        <TextView
            android:id="@+id/top_banner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#f8860c"
            android:fontFamily="sans-serif"
            android:paddingVertical="20px"
            android:paddingBottom="5dp"
            android:text="CourseList"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Bottom-left anchor space -->
            <Space
                android:id="@+id/space2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Bottom-right anchor space -->
            <Space
                android:id="@+id/space"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- "+" button: above the bottom-right space, anchored to the right edge -->

            <!-- "•••" button: to the left of the "+" button, aligned to bottom of space -->

            <!-- Calculator button: bottom-left, anchored to start and bottom -->

            <!-- Calendar button: centered horizontally between the two spaces -->

            <!-- Bottom orange banner: pinned to bottom, full width -->

            <Button
                android:id="@+id/button2"
                android:layout_width="58dp"
                android:layout_height="55dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="36dp"
                android:background="@drawable/round_button"
                android:backgroundTint="#F8860C"
                android:onClick="newCourse"
                android:paddingBottom="6dp"
                android:text="+"
                android:textAlignment="center"
                android:textSize="40dp"
                app:layout_constraintBottom_toTopOf="@+id/space"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/top_banner3"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:background="#f8860c"
                android:fontFamily="sans-serif"
                android:paddingVertical="20px"
                android:paddingBottom="5dp"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0" />
            <include
                android:id="@+id/nav"
                layout="@layout/nav_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>





</FrameLayout>